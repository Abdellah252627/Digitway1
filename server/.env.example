PORT=5000
NODE_ENV=development
ADMIN_EMAIL=admin@digitway.com
JWT_SECRET=REPLACE_WITH_GENERATED_SECRET_node_-e_"require('crypto').randomBytes(48).toString('hex')"

# Turso Database (libSQL) — Cloud SQLite with free tier
# Get URL + token from: https://turso.tech
# CLI: turso db create digitway && turso db tokens create digitway
# For local dev, leave as file: path (no token needed)
TURSO_DATABASE_URL=file:./data/digitway.db
TURSO_AUTH_TOKEN=


# External Telegram Bot Integration for Real-time alerts
# Get your BOT token from @BotFather and your Chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SMTP Email Configuration (Optional - in dev mode, OTP is logged to console & UI)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Digitway Admin <auth@digitway.com>"
